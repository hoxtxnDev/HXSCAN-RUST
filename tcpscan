#!/usr/bin/env sh
# Hardened zero-friction launcher for `tcpscan` (HXSCAN-RUST v3.0.0).
# Protects against environment variable / CDPATH / IFS injection and executes the compiled binary.

set -eu
unset CDPATH
IFS="$(printf ' \t\n')"
export LC_ALL=C

SOURCE="$0"
while [ -L "$SOURCE" ]; do
    DIR="$(cd -- "$(dirname -- "$SOURCE")" && pwd)"
    SOURCE="$(readlink -- "$SOURCE")"
    case "$SOURCE" in
        /*) ;;
        *) SOURCE="$DIR/$SOURCE" ;;
    esac
done
SCRIPT_DIR="$(cd -- "$(dirname -- "$SOURCE")" && pwd)"
BIN_PATH="$SCRIPT_DIR/target/release/tcpscan"

if [ ! -x "$BIN_PATH" ]; then
    if command -v cargo >/dev/null 2>&1; then
        cargo build --release --manifest-path "$SCRIPT_DIR/Cargo.toml" --quiet
    elif [ -x "/opt/homebrew/bin/cargo" ]; then
        /opt/homebrew/bin/cargo build --release --manifest-path "$SCRIPT_DIR/Cargo.toml" --quiet
    else
        echo "[!] Error: 'tcpscan' binary not found and 'cargo' is not in PATH." >&2
        exit 1
    fi
fi

exec "$BIN_PATH" "$@"
